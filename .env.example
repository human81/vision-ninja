# Vision Ninja Studio — copy to `.env` (gitignored) and fill in.
# With a Gemini key the agent brain runs on Google ADK + Gemini; without one it
# falls back to the deterministic SimRunner ($0). Get a key:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=0
# Optional default source for `run.py studio` / uvicorn:
# OCC_SOURCE=assets/videos/vehicles-2.mp4
